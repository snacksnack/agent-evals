<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily free kpi-ledger run (RC1-315). __HOME__ is substituted by
     scripts/install_launchd.sh. launchd runs a missed StartCalendarInterval
     on wake, so a closed laptop at 09:00 means a run at wake, not a gap. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hihelloreid.agent-evals.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/programming/personal/agent-evals/scripts/scheduled_eval.sh</string>
    <string>daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/agent-evals/daily.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/agent-evals/daily.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
